# Copie para .env na raiz (nunca versionar o .env). Valores de DESENVOLVIMENTO local.
VIDACOR_ENDERECO=127.0.0.1:8080
VIDACOR_BANCO_URL=postgres://vidacor_app:dev_app@127.0.0.1:5432/vidacor
VIDACOR_BANCO_ADMIN_URL=postgres://postgres:dev_admin@127.0.0.1:5432/vidacor
VIDACOR_URL_APLICACAO=http://127.0.0.1:5173
VIDACOR_URL_API=http://127.0.0.1:5173
VIDACOR_COOKIE_INSEGURO_DEV=1
VIDACOR_ORTHANC_URL=http://127.0.0.1:8042
VIDACOR_UNIDADE=0194f000-0000-7000-8000-0000000000a1
VIDACOR_OIDC_EMISSOR=http://127.0.0.1:8081/realms/vidacor
VIDACOR_OIDC_CLIENTE=vidacor-web
VIDACOR_OIDC_SEGREDO=dev-segredo-somente-local
# Simulados de desenvolvimento, SEM VALOR LEGAL nem financeiro (DEC-2026-11-08-53). Nunca em produção.
VIDACOR_ASSINADOR=desenvolvimento
VIDACOR_PSP=desenvolvimento
VIDACOR_PIX_WEBHOOK_SEGREDO=dev-segredo-webhook-somente-local
# E-mail de desenvolvimento (Mailpit do compose) e segredo do convite do portal (mín. 32 caracteres; só dev).
VIDACOR_SMTP_URL=smtp://127.0.0.1:1025
VIDACOR_EMAIL_REMETENTE="VidaCor Imagem <portal@vidacor.invalid>"
VIDACOR_CONVITE_SEGREDO=dev-segredo-do-convite-somente-local-0000

# Visualizador OHIF (ADR-0006): endereço público; sem ele, a tela diz que não está instalado.
# VIDACOR_VISUALIZADOR_URL=http://127.0.0.1:3000/viewer
