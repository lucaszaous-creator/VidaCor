{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visualizador VidaCor",
  "version": "0.2.0",
  "identifier": "br.com.vidacorimagem.visualizador",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "principal",
        "title": "Visualizador VidaCor",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-38RhXrc7EdReTKsOm23ZPOCUgniTUUcjky8QOOrQx6o='; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Medical",
    "shortDescription": "Abrir exames DICOM e gerar PDF e JPEG para o paciente",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ]
      },
      "wix": {
        "language": "pt-BR"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "publisher": "VIDACOR SERVICOS MEDICOS MACAE LTDA",
    "copyright": "VIDACOR SERVICOS MEDICOS MACAE LTDA"
  }
}
