  "query": "SELECT a.id, a.codigo, a.situacao, a.sala_id, a.unidade_id,\n                  p.id AS paciente_id, p.nome, p.nascimento\n             FROM agenda.agendamento a\n             JOIN identidade.paciente p ON p.id = a.paciente_id\n            WHERE a.id = $1\n            FOR UPDATE OF a",
