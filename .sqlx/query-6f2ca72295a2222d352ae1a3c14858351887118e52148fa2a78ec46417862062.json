{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id AS agendamento_id, a.inicio, p.nome, p.nascimento, a.exame_nome AS exame, s.nome AS sala, a.situacao\n             FROM agenda.agendamento a JOIN identidade.paciente p ON p.id = a.paciente_id JOIN agenda.sala s ON s.id = a.sala_id\n            WHERE a.inicio >= $1 AND a.inicio < $2 AND a.situacao IN ('agendado','confirmado','reserva_provisoria')\n            ORDER BY a.inicio LIMIT 6",
