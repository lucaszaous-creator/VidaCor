  "query": "SELECT p.id, p.nome, p.nascimento, a.codigo, m.quantidade, m.criado_em\n           FROM estoque.movimento m JOIN identidade.paciente p ON p.id = m.paciente_id JOIN recepcao.atendimento a ON a.id = m.atendimento_id\n           WHERE m.lote_id = $1 AND m.tipo = 'baixa_exame' ORDER BY m.criado_em",
