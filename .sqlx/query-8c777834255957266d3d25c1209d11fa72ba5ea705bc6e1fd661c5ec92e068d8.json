  "query": "SELECT m.codigo, m.tipo, m.motivo, m.versao_do_procedimento, m.antes, m.depois, u.nome AS quem, m.criado_em\n             FROM agenda.procedimento_mudanca m JOIN identidade.usuario u ON u.id = m.criado_por\n            WHERE m.tuss = $1 ORDER BY m.versao_do_procedimento DESC LIMIT 200",
