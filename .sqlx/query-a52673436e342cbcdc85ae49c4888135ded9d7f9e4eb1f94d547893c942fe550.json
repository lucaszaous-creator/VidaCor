  "query": "SELECT k.id, k.codigo, k.operadora, k.registro_ans, k.regra_versao, k.prazo_envio_dias, k.prazo_recurso_dias,\n                  (SELECT count(*) FROM faturamento.conta c WHERE c.contrato_id = k.id AND c.situacao = 'pronta') AS \"contas_prontas!\"\n             FROM faturamento.contrato k WHERE k.ativo ORDER BY k.operadora",
