{
  "db_name": "PostgreSQL",
  "query": "SELECT a.codigo, a.inicio, s.nome AS sala, p.nome, p.nascimento, a.exame_nome\n                 FROM agenda.agendamento a JOIN agenda.sala s ON s.id = a.sala_id JOIN identidade.paciente p ON p.id = a.paciente_id\n                WHERE a.unidade_id = $1 AND a.inicio >= $2 AND a.inicio < $3 AND a.situacao NOT IN ('cancelado','expirada')\n                ORDER BY s.codigo, a.inicio",
