  "query": "SELECT p.id, p.codigo, p.numero, p.passos, p.chegar_antes_min, p.vigente, p.motivo, p.criado_em, u.nome AS \"criado_por!\"\n             FROM agenda.preparo p JOIN identidade.usuario u ON u.id = p.criado_por\n            WHERE p.tuss = $1 AND (p.vigente OR NOT $2) ORDER BY p.numero DESC",
