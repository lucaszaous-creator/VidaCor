  "query": "SELECT e.codigo, e.relatorio, e.formato, e.de, e.ate, e.conteudo, e.linhas, e.sha256, u.nome AS quem, e.criado_em\n             FROM relatorios.exportacao e JOIN identidade.usuario u ON u.id = e.criado_por\n            WHERE e.criado_em >= $1 ORDER BY e.criado_em DESC LIMIT 200",
